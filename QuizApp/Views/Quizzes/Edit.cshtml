@model QuizApp.Models.ViewModels.EditQuizViewModel

@{
    ViewData["Title"] = "Edit Quiz";
}

<div class="page-container">
    <h1>Edit Quiz: @Model.Title</h1>

    <form asp-action="Edit" method="post">
        <!-- CRITICAL: Hidden ID so the server knows which quiz to update -->
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-input" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-input" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="admin-form-grid">
            <div class="form-group">
                <label asp-for="Category"></label>
                <input asp-for="Category" class="form-input" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Difficulty"></label>
                <select asp-for="Difficulty" class="form-input" asp-items="Html.GetEnumSelectList<DifficultyLevel>()"></select>
                <span asp-validation-for="Difficulty" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TimeLimitMinutes"></label>
                <input asp-for="TimeLimitMinutes" type="number" class="form-input" />
                <span asp-validation-for="TimeLimitMinutes" class="text-danger"></span>
            </div>
        </div>

        <div style="margin-top: 1.5rem;">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>