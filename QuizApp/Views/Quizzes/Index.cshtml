@model IEnumerable<QuizApp.Models.ViewModels.QuizListItemViewModel>

@{
    ViewData["Title"] = "Browse Quizzes";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold mb-1">Explore Quizzes</h1>
            <p class="text-muted mb-0">Test your knowledge across various topics.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Create Quiz</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">No quizzes available yet.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var quiz in Model) // Model is a property
            {
                <div class="col-md-6 col-lg-4">
                    <div class="quiz-card h-100 d-flex flex-column">
                        <div class="mb-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary">@quiz.Category</span>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">@quiz.Difficulty</span>
                        </div>

                        <h3 class="h5 fw-bold mb-2">@quiz.Title</h3>
                        <p class="text-muted small flex-grow-1">@(quiz.Description ?? "No description provided.")</p>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <small class="text-muted">
                                <i class="bi bi-clock"></i> @quiz.TimeLimitMinutes min &bull; @quiz.QuestionCount Qs
                            </small>
                            <a asp-action="Details" asp-route-id="@quiz.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>